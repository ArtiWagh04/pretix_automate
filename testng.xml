<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM
        "https://testng.org/testng-1.0.dtd">

<suite name="Parallel Browser Suite"
       parallel="tests"
       thread-count="2">

    <test name="Chrome Tests">
        <classes>
            <class name="testRunners.ChromeRunner"/>
        </classes>
    </test>

    <test name="Edge Tests">
        <classes>
            <class name="testRunners.EdgeRunner"/>
        </classes>
    </test>

</suite>